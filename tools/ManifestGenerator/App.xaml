<Application x:Class="TanssAddin.ManifestGenerator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- Bewusst schlicht und ohne Fremdbibliothek: Das Werkzeug hat acht Felder und
         einen Knopf. Wer es an das Aussehen der uebrigen Anwendungen angleichen will,
         legt eine Oberflaechenbibliothek darueber - die Fachlogik in Options, Renderer
         und AddinId bleibt davon unberuehrt. -->

    <SolidColorBrush x:Key="Flaeche"  Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="Linie"    Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="Gedaempft" Color="#FF606060"/>
    <SolidColorBrush x:Key="Fehler"   Color="#FFB00020"/>
    <SolidColorBrush x:Key="Gut"      Color="#FF1B6B2A"/>

    <Style TargetType="TextBlock" x:Key="Beschriftung">
      <Setter Property="Margin" Value="0,12,0,3"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="Hinweis">
      <Setter Property="Margin" Value="0,3,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource Gedaempft}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,5"/>
      <Setter Property="BorderBrush" Value="{StaticResource Linie}"/>
    </Style>

  </Application.Resources>
</Application>
